{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "~/*": ["./app/*"] },
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["app/**/*"]
}
